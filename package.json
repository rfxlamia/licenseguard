{
  "name": "licenseguard-cli",
  "version": "2.2.0",
  "description": "License setup & compliance guard for developers",
  "bin": {
    "licenseguard": "bin/licenseguard.js"
  },
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "postinstall": "node lib/postinstall.js"
  },
  "keywords": [
    "license",
    "compliance",
    "scanning",
    "spdx",
    "dependencies",
    "MIT",
    "Apache",
    "GPL",
    "developer-tools",
    "license-checker"
  ],
  "author": "v",
  "license": "MIT",
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "inquirer": "^8.2.5",
    "spdx-expression-parse": "^4.0.0",
    "spdx-satisfies": "^6.0.0"
  },
  "devDependencies": {
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "mock-fs": "^5.2.0",
    "prettier": "^3.1.0"
  }
}
